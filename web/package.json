{
  "name": "civicguard-web",
  "version": "0.0.0",
  "private": true,
  "description": "PWA de CivicGuard (React + TypeScript + Vite).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/inject-sw.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs --lazy Panel,camera",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
