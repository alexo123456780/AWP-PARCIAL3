# Copia este archivo a `.env` (`cp .env.example .env`) antes de `docker compose up --build`.
# `.env` está en .gitignore: nunca subas valores reales.

# --- Base de datos (db, liquibase y backend) ---
DB_NAME=civicguard
DB_USER=civicguard
# Valor de ejemplo solo para desarrollo local; cámbialo en tu `.env`.
DB_PASSWORD=change-me
# Puerto del host (solo loopback) donde se publica Postgres; cámbialo si el 5432 ya está ocupado.
DB_PORT=5432

# --- Fotos de los reportes (Supabase Storage, opcional en local) ---
# La API sube las fotos a un bucket PÚBLICO. SUPABASE_URL y SUPABASE_SERVICE_KEY van juntas o ninguna; sin ellas
# un reporte con foto responde 503 y queda pendiente en el dispositivo. La clave de servicio es secreta: solo aquí.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=incident-photos

# --- Autenticación del coordinador ---
# Secreto con el que se firman los JWT (mínimo 32 caracteres, p. ej. `openssl rand -base64 32`). Sin él el login
# responde 503. Es secreto: solo aquí, nunca en el repositorio.
JWT_SECRET=

# --- Frontend ---
# URL de la API vista desde el navegador (se incrusta al construir la imagen prod).
VITE_API_URL=http://localhost:3000

# --- Túnel ngrok (opcional) ---
# Dominio público sin esquema (ej. mi-app.ngrok-free.app): se añade al CORS del backend
# y a server.allowedHosts de Vite para probar en un teléfono real. Déjalo vacío si no usas ngrok.
NGROK_DOMAIN=
